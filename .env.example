# =============================================================================
# Public unified API / FastAPI
# =============================================================================
API_BIND_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=2
API_KEEP_ALIVE=5
API_LOG_LEVEL=info
API_TITLE=Docling Qdrant Advanced RAG Harness
API_DESCRIPTION=Unified ingestion and advanced RAG API backed by Docling, Qdrant, Redis and Celery.
API_VERSION=2.0.0
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json
API_ROOT_PATH=
API_PUBLIC_BASE_URL=
API_ALLOWED_HOSTS=*
API_CORS_ORIGINS=*
API_CORS_ALLOW_CREDENTIALS=false
API_CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
API_CORS_ALLOW_HEADERS=*
API_MAX_BATCH_FILES=100
API_UPLOAD_BUFFER_MB=1

# Optional authentication. Empty means disabled for local development.
API_KEY=
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_ID=default

# =============================================================================
# Storage / queue
# =============================================================================
QDRANT_COLLECTION=documents_v2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Comma-separated metadata keys to index, e.g. department,classification,project
QDRANT_METADATA_INDEX_FIELDS=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_VISIBILITY_TIMEOUT=7200
CELERY_RESULT_EXPIRES=604800
JOB_OWNER_TTL_SECONDS=604800
DEDUPE_PENDING_TTL_SECONDS=7200

# =============================================================================
# Embeddings / hybrid retrieval
# =============================================================================
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
SPARSE_MODEL=Qdrant/bm25
BM25_LANGUAGE=portuguese
EMBEDDING_BATCH_SIZE=32
RERANKER_ENABLED=false
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

RETRIEVAL_MODE=hybrid
DEFAULT_TOP_K=8
DEFAULT_CANDIDATE_K=40
MAX_TOP_K=50
MAX_CANDIDATE_K=200
# Empty = disabled; note that score scales differ between dense, sparse and RRF.
DEFAULT_SCORE_THRESHOLD=
MAX_CONTEXT_CHARS=60000

# =============================================================================
# Docling and chunking defaults. Per-upload processing_options can override these.
# Supported CHUNKER_TYPE: hybrid | hierarchical | line_based
# =============================================================================
CHUNKER_TYPE=hybrid
CHUNK_TOKENIZER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_TOKENS=120

# HybridChunker
CHUNK_HYBRID_MERGE_PEERS=true
CHUNK_HYBRID_REPEAT_TABLE_HEADER=true
CHUNK_HYBRID_OMIT_HEADER_ON_OVERFLOW=false
CHUNK_HYBRID_ALWAYS_EMIT_HEADINGS=false

# HierarchicalChunker
CHUNK_HIERARCHICAL_MERGE_LIST_ITEMS=true
CHUNK_HIERARCHICAL_ALWAYS_EMIT_HEADINGS=false

# LineBasedTokenChunker
CHUNK_LINE_PREFIX=
CHUNK_LINE_OMIT_PREFIX_ON_OVERFLOW=false

# PDF conversion
PDF_DO_OCR=true
PDF_DO_TABLE_STRUCTURE=true
PDF_DO_CELL_MATCHING=true
DOCLING_MAX_NUM_PAGES=1000
PARSER_FULL_DOCLING_METADATA=false
MAX_FILE_MB=100
DEFAULT_DEDUPLICATE=true
DELETE_SOURCE_AFTER_INGEST=false
PARSER_TIMEOUT_SECONDS=1800
EMBEDDER_TIMEOUT_SECONDS=900

# =============================================================================
# Worker
# =============================================================================
WORKER_CONCURRENCY=2
WORKER_MAX_TASKS_PER_CHILD=20
WORKER_LOG_LEVEL=INFO

# =============================================================================
# Agent/chat memory and optional OpenAI-compatible LLM
# =============================================================================
CHAT_MEMORY_TTL_SECONDS=86400
CHAT_HISTORY_MESSAGES=8
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Optional host bind/port overrides. Use 0.0.0.0 deliberately for remote access.
REDIS_BIND_HOST=127.0.0.1
QDRANT_BIND_HOST=127.0.0.1
DOCS_BIND_HOST=127.0.0.1
FLOWER_BIND_HOST=127.0.0.1
REDIS_BIND_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
FLOWER_PORT=5555
DOCS_PORT=8004
